# Local development (docker-compose Postgres + Vite dev server)
DATABASE_URL=postgresql://contextport:contextport@localhost:5432/context_port
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
# Optional comma-separated extra browser origins (e.g. Vercel preview URLs)
WEB_EXTRA_ORIGINS=
DEPLOYMENT_MODE=local
LOG_LEVEL=log
VITE_API_BASE_URL=/api/v1

# ---- Google login (required to use the local Web; all three set together) ----
# Create an OAuth Web client at https://console.cloud.google.com and register
# ${PUBLIC_BASE_URL}/api/v1/auth/google/callback as an authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_BASE_URL=http://localhost:5173
# Force Secure cookies: 'auto' enables them when DEPLOYMENT_MODE=network.
# COOKIE_SECURE=auto

# ---- Production (Render server + Vercel web + Neon Postgres) ----
# Server (Render environment):
#   DATABASE_URL=<Neon pooled connection string, ?sslmode=require>
#     Render free has no pre-deploy step, so run migrations yourself with the
#     DIRECT (unpooled) connection string before/after schema-changing deploys:
#       DATABASE_URL=<direct> pnpm db:migrate
#   HOST=0.0.0.0
#   PORT=<injected by Render, do not hardcode>
#   WEB_ORIGIN=https://<your-app>.vercel.app
#   WEB_EXTRA_ORIGINS=https://<preview-1>.vercel.app,https://<preview-2>.vercel.app
#   DEPLOYMENT_MODE=network
# Web (Vercel project settings):
#   VITE_API_BASE_URL=/api/v1  (same-origin; vercel.json rewrites /api/* to Render)
