{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @contextport/web... build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://contextport-server.jieke.workers.dev/api/:path*" },
    { "source": "/mcp", "destination": "https://contextport-server.jieke.workers.dev/mcp" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
